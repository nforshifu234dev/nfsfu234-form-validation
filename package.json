{
  "name": "@nfsfu234/form-validation",
  "author": "NFORSHIFU234 Dev",
  "homepage": "https://form-validation.nforshifu234dev.com",
  "version": "3.0.0",
  "config": {
    "version_short": "3"
  },
  "description": "A lightweight, dependency-free client-side form validation library for HTML forms - inputs, textareas, selects, radios, and checkboxes - with inline or modal error messages, AJAX submission, and a declarative config layer for validating forms across a whole multi-page site.",
  "license": "MIT",
  "main": "dist/js/nfsfu234FormValidation.cjs",
  "style": "dist/css/nfsfu234FormValidation.min.css",
  "module": "dist/js/nfsfu234FormValidation.mjs",
  "unpkg": "dist/js/nfsfu234FormValidation.global.js",
  "jsdelivr": "dist/js/nfsfu234FormValidation.global.js",
  "types": "dist/js/nfsfu234FormValidation.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/nfsfu234FormValidation.d.ts",
      "import": {
        "types": "./dist/js/nfsfu234FormValidation.d.mts",
        "default": "./dist/js/nfsfu234FormValidation.mjs"
      },
      "require": {
        "types": "./dist/js/nfsfu234FormValidation.d.ts",
        "default": "./dist/js/nfsfu234FormValidation.cjs"
      }
    },
    "./css": {
      "types": "./dist/types/css.d.ts",
      "default": "./dist/css/nfsfu234FormValidation.min.css"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nforshifu234dev/nfsfu234-form-validation.git"
  },
  "bugs": {
    "url": "https://github.com/nforshifu234dev/nfsfu234-form-validation/issues"
  },
  "directories": {
    "test": "test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "autoupdate": {
    "source": "npm",
    "target": "@nfsfu234/form-validation",
    "fileMap": [
      {
        "basePath": "dist",
        "files": [
          "dist/js/**/*.js",
          "dist/js/**/*.cjs",
          "dist/js/**/*.mjs",
          "dist/css/**/*.css",
          "dist/js/**/*.map",
          "dist/css/**/*.map"
        ]
      }
    ]
  },
  "jspm": {
    "registry": "npm",
    "main": "dist/js/nfsfu234FormValidation",
    "directories": {
      "lib": "dist"
    }
  },
  "scripts": {
    "clean": "npx rimraf dist",
    "build:js": "tsup",
    "build:css": "node build-css.cjs",
    "build:umd": "node build-umd.js",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky",
    "docs:build": "typedoc",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run docs:build"
  },
  "files": [
    "dist/js/**/*.js",
    "dist/js/**/*.cjs",
    "dist/js/**/*.mjs",
    "dist/css/**/*.css",
    "dist/js/**/*.map",
    "dist/css/**/*.map",
    "dist/js/**/*.d.ts",
    "dist/js/**/*.d.cts",
    "docs-json/api.json"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@swc/core": "^1.6.13",
    "@types/jest": "^29.5.12",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^9.1.3",
    "buffer": "^6.0.3",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "crypto-browserify": "^3.12.0",
    "css-loader": "^6.10.0",
    "css-minimizer-webpack-plugin": "^6.0.0",
    "cssnano": "^7.0.4",
    "esbuild": "^0.23.0",
    "file-loader": "^6.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.39",
    "postcss-cli": "^11.0.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^25.0.8",
    "stream-browserify": "^3.0.0",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.1.1",
    "typedoc": "^0.26.7",
    "typescript": "^5.4.2",
    "vm-browserify": "^1.1.2"
  },
  "keywords": [
    "form-validation",
    "form",
    "validation",
    "html-forms",
    "client-side-validation",
    "input-validation",
    "email-validation",
    "password-strength",
    "ajax-form-submit",
    "vanilla-js",
    "typescript",
    "javascript",
    "frontend",
    "browser",
    "shifu",
    "nforshifu234dev"
  ]
}
